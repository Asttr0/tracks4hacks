# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Stray tsc emit (we use Vite for transpilation; tsc has noEmit)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
tests/**/*.js
tests/**/*.js.map
vite.config.js
vitest.config.js

# Environment / secrets — NEVER commit
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# Netlify
.netlify/

# Test / coverage
/coverage/
.vitest-cache/

# Claude Code
.claude/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

